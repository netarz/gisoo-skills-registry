{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/netarz/gisoo-skills-registry/schema/meta.schema.json",
  "title": "Gisoo skills registry: skills/<id>/meta.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "title_fa", "description", "description_fa", "publisher", "categories", "language", "version", "license", "verified", "added_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 2, "maxLength": 48 },
    "title": { "type": "string", "minLength": 1, "maxLength": 60 },
    "title_fa": { "type": "string", "minLength": 1, "maxLength": 60 },
    "description": { "type": "string", "minLength": 10, "maxLength": 280 },
    "description_fa": { "type": "string", "minLength": 10, "maxLength": 280 },
    "publisher": {
      "type": "object", "additionalProperties": false, "required": ["name", "url"],
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 80 }, "url": { "type": "string", "pattern": "^https://", "maxLength": 300 } }
    },
    "categories": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 32 } },
    "tags": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
    "language": { "enum": ["fa", "en", "multi"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 40 },
    "verified": { "type": "boolean" },
    "added_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
